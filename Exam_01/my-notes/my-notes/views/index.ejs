<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>My Notes</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <div class="container">

        <h1>My Notes</h1>
        <form action="/" method="GET" class="search-form">

    <input
        type="text"
        name="search"
        placeholder="Search notes by title"
    >

    <button type="submit">
        Search
    </button>

</form>

        <a href="/notes/new" class="add-btn">
            + Add New Note
        </a>


        <% if (notes.length === 0) { %>

            <p class="empty">
                No notes are available.
            </p>

        <% } else { %>

            <% notes.forEach(note => { %>

                <div class="note">

                    <h2>
                        <%= note.title %>
                    </h2>

                    <p>
                        <%= note.content %>
                    </p>

                    <p>
                        <strong>Category:</strong>
                        <%= note.category %>
                    </p>

                    <p>
                        <strong>Created:</strong>
                        <%= new Date(note.createdAt).toLocaleString() %>
                    </p>

                    <form
                        action="/notes/<%= note._id %>/delete"
                        method="POST"
                    >

                        <button type="submit">
                            Delete
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } %>

    </div>

</body>

</html>
