<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Users</title></head>
<body>
  <h2>Registered Users</h2>
  <% if (users.length === 0) { %><p>No users registered yet.</p><% } %>
  <ul>
    <% users.forEach((user) => { %>
      <li><%= user.username %> | <%= user.email %> | <%= user.createdAt.toDateString() %></li>
    <% }) %>
  </ul>
  <a href="/">Back to home</a>
</body>
</html>
