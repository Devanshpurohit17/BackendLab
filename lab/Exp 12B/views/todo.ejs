<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><title>Session To-Do</title>
  <style>.dark { background: #222; color: #eee; }</style>
</head>
<body class="<%= theme %>">
  <h1>Session To-Do List</h1>
  <form action="/add" method="POST"><input name="todoItem" aria-label="Item" required> <button>Add</button></form>
  <ul>
    <% todos.forEach((item, index) => { %>
      <li><%= item %>
        <form action="/delete/<%= index %>" method="POST" style="display:inline"><button>Delete</button></form>
      </li>
    <% }) %>
  </ul>
  <form action="/theme" method="POST"><button>Change theme</button></form>
</body>
</html>
