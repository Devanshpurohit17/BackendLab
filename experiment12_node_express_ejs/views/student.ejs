<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav>
    <div class="container nav-inner">
        <a href="/">Home</a>
        <a href="/students">Students</a>
        <a href="/api/students">REST API</a>
    </div>
</nav>

<main class="container">
    <section class="card profile">
        <p class="eyebrow">URL PARAMETER DEMONSTRATION</p>
        <h1><%= student.name %></h1>

        <dl>
            <dt>Student ID</dt>
            <dd><%= student.id %></dd>

            <dt>Email</dt>
            <dd><%= student.email %></dd>

            <dt>Course</dt>
            <dd><%= student.course %></dd>
        </dl>

        <p>
            This page was generated using the route
            <code>/student/:id</code>.
        </p>

        <a class="button" href="/students">Back to Students</a>
    </section>
</main>

<footer>Experiment 12 • EJS Dynamic Route</footer>
</body>
</html>